# Practice mode requires no environment variables.
# Optional exact browser origin for a custom competition host. Set in the server process environment.
# WALLET_RUSH_ORIGIN=https://wallet-rush.example

# World ID 4.0. Staging uses the official simulator.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=wallet-rush-mumbai-2026
WORLD_ENVIRONMENT=staging
# WORLD_ELIGIBILITY_FILE=.env.world-eligibility.json
# PRIZE_ENTRY_FILE=.env.prize-entries.jsonl

# Studio-created Arc Testnet escrow and dedicated referee test wallet.
ARC_STUDIO_PROJECT_URL=
ARC_ESCROW_ADDRESS=
ARC_ESCROW_VERSION=1
ARC_REFEREE_KEY=

# Arkiv Rabdi test writer. Only VITE_ values are exposed to the browser.
ARKIV_WRITER_KEY=
ARKIV_ACCESS_KEY=
VITE_ARKIV_WRITER_ADDRESS=
VITE_ARKIV_ACCESS_KEY=
